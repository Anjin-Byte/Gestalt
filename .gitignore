# target/; ignore those too so they never get committed.
**/target/
**/*.rs.bk
.DS_Store

# GPU profiler captures (make trace / programmatic .gputrace).
*.trace
*.gputrace

# wasm-pack output for the web front end — a build artifact (the .d.ts surface
# is reviewed via the CI diff gate, not by committing the package).
crates/voxel-web/pkg/

docs/*
models/*