{
  "name": "voxel-web-shell",
  "description": "TypeScript shell for the voxel-web WASM kernel: owns the canvas element, the rAF loop, DOM input, and the HUD (docs/design/web-frontend-api.md).",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "voxel-web": "file:../crates/voxel-web/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "fast-check": "^4.9.0",
    "globals": "^16",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  }
}
